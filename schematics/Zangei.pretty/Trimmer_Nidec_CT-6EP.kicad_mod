(footprint "Trimmer_Nidec_CT-6EP"
 (version 20260206) (generator "pcbnew") (layer "F.Cu")
 (descr "Nidec CT-6EP top-adjust trimmer, CT-6 datasheet p4. Top view: 1=(0,0), 2=(2.5,-2.5) wiper, 3=(5,0). Nominal body7x7x5.8mm; unspecified tolerance +/-0.3mm. Courtyard includes max body plus0.25mm. 3D is labelled maximum-envelope approximation.")
 (attr through_hole)
 (property "Reference" "REF**" (at 2.5 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
 (property "Value" "CT-6EP103" (at 2.5 4.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
 (fp_rect (start -1 -3.5) (end 6 3.5) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
 (fp_rect (start -1.15 -3.65) (end 6.15 3.65) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
 (fp_rect (start -1.4 -3.9) (end 6.4 3.9) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
 (fp_circle (center 2.5 0) (end 4.3 0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
 (pad "1" thru_hole rect (at 0 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
 (pad "2" thru_hole circle (at 2.5 -2.5) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
 (pad "3" thru_hole circle (at 5 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
 (model "${KIPRJMOD}/Zangei.3dshapes/Trimmer_CT-6EP_Envelope.wrl"
  (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
