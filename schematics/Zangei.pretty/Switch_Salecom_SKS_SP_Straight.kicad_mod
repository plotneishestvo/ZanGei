(footprint "Switch_Salecom_SKS_SP_Straight"
 (version 20260206) (generator "pcbnew") (layer "F.Cu")
 (descr "Salecom SKS04SP/SKS07SP straight-PCB Fig1. 2.54mm terminal pitch; 1.52x0.51mm tab leads, 1.8mm circular holes. Pin2 common. Conservative9x9mm body envelope includes8.13x6.1mm body; shaft seating/end-contact direction require assembled-panel check. No3D model.")
 (attr through_hole)
 (property "Reference" "REF**" (at 0 -5.8 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
 (property "Value" "SKS_SP" (at 0 5.8 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
 (fp_rect (start -4.5 -4.5) (end 4.5 4.5) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
 (fp_rect (start -4.75 -4.75) (end 4.75 4.75) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
 (pad "1" thru_hole rect (at 0 -2.54) (size 2.3 2.3) (drill 1.8) (layers "*.Cu" "*.Mask"))
 (pad "2" thru_hole circle (at 0 0) (size 2.3 2.3) (drill 1.8) (layers "*.Cu" "*.Mask"))
 (pad "3" thru_hole circle (at 0 2.54) (size 2.3 2.3) (drill 1.8) (layers "*.Cu" "*.Mask"))

	(model "${KIPRJMOD}/Zangei.3dshapes/Salecom_SKS_ENVELOPE.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
